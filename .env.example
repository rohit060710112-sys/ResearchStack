# ResearchMind — Environment Variables
# Copy this file to .env and insert your personal API keys

# Groq LLM Key: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Tavily Search & Batch Extract Key: https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# 🛡️ Observability: LangSmith Tracing (Optional)
# Get a free key at: https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=ResearchStack

# 🛡️ Observability: LangSmith Tracing (Optional)
# Get a free key at: https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=ResearchStack

